COMPOSE_PROJECT_NAME=web-semantic

# Images et ports exposes uniquement sur cette machine.
PYTHON_VERSION=3.13
POSTGRES_VERSION=17
JAVA_VERSION=21-jre-jammy
FUSEKI_VERSION=6.2.0
WEB_PORT=8000
POSTGRES_PORT=5432
FUSEKI_PORT=3030

# Django : generer une cle differente pour chaque environnement.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Africa/Tunis
DJANGO_LANGUAGE_CODE=fr
DJANGO_MEDIA_ROOT=/app/media
DJANGO_STATIC_ROOT=/app/staticfiles
PDF_UPLOAD_MAX_MB=20

# Utilises uniquement pour creer explicitement un administrateur.
# Changer ces valeurs ne modifie pas un compte deja cree en base.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=replace-with-a-random-admin-password

# PostgreSQL : dans Docker, le nom du service est l'hote.
POSTGRES_DB=web_semantic
POSTGRES_USER=web_semantic
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db

# Fuseki : le dataset est cree automatiquement, les donnees persistent.
FUSEKI_BASE_URL=http://fuseki:3030
FUSEKI_DATASET=education
FUSEKI_JAVA_OPTIONS=-Xms128m -Xmx768m
FUSEKI_TIMEOUT_SECONDS=5
SEMANTIC_NAMESPACE=https://example.org/education#

# Outil ponctuel HermiT ; aucun service supplementaire au demarrage normal.
REASONER_IMAGE=maven:3.9-eclipse-temurin-21

# Recherche en langage naturel : cle privee, jamais envoyee au navigateur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
