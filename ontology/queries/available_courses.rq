# Quels cours sont accessibles en connaissant déjà algorithmique, Python et HTTP ?
# Aucun profil utilisateur n'est enregistré ; ces compétences sont des paramètres.
PREFIX edu: <https://example.org/education#>
SELECT ?cours ?titre WHERE {
  GRAPH <https://example.org/education/graphs/catalogue> {
    ?cours a edu:Cours ; edu:titre ?titre .
    FILTER NOT EXISTS {
      ?cours edu:exigeCompetence ?requise .
      FILTER (?requise NOT IN (edu:competence_algo, edu:competence_python, edu:competence_http))
    }
  }
} ORDER BY ?titre
