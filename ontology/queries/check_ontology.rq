# L'ontologie est chargee dans un graphe nomme.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?classe ?libelle
WHERE {
  GRAPH <https://example.org/education/graphs/ontology> {
    ?classe a owl:Class .
    OPTIONAL { ?classe rdfs:label ?libelle }
  }
}
ORDER BY ?classe

