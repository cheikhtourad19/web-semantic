# Quels sont les cours prérequis directs de Django ?
PREFIX edu: <https://example.org/education#>
SELECT ?prerequis ?titre WHERE {
  GRAPH <https://example.org/education/graphs/catalogue> {
    edu:cours_django edu:aPourPrerequisCours ?prerequis .
    ?prerequis edu:titre ?titre .
  }
} ORDER BY ?titre
